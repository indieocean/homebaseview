{
  "name": "homeview",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Ring camera viewer: local server + web UI + macOS menu bar app",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check web/app.js",
    "app": "bash macos/build-app.sh"
  },
  "dependencies": {
    "@homebridge/camera-utils": "^3.0.0",
    "express": "^4.22.3",
    "ffmpeg-for-homebridge": "^2.2.2",
    "hls.js": "^1.7.4",
    "ring-client-api": "^14.3.0",
    "rxjs": "^7.8.2",
    "werift": "^0.22.4"
  }
}
